NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lets_buddy

# Boş bırakılırsa herhangi bir e-posta domaini kabul edilir.
# Kısıtlamak için virgülle ayrılmış liste verin, örn: "ornek.edu.tr,.edu.tr"
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_MINUTES=10

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Dosya depolama (MVP: yerel disk; ileride S3 vb. ile değiştirilebilir)
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
